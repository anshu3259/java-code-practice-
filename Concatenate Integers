Given two integers a and b, you need to concatenate them so the output is ab and print it.

import java.lang.*;
import java.util.*;

class GFG {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();

        // code here
        System.out.println(a+""+b);
    }
}
