Given two arrays a[] and b[], your task is to determine whether b[] is a subset of a[].


class Solution {
    public boolean isSubset(int a[], int b[]) {
        // Your code here
   
       HashSet<Integer> set = new HashSet<>();

        // Store all elements of a
        for (int num : a) {
            set.add(num);
        }

        // Check every element of b
        for (int num : b) {
            if (!set.contains(num)) {
                return false;
            }
        }

        return true;
    }
    
    
}
