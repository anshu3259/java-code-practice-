Given an integer n, print a solid square pattern of size n × n using "* " (a star followed by exactly one space).

import java.util.Scanner;

class GFG {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        // code here
        for (int i=1;i<=n;i++){
            for(int j=1;j<=n;j++){
                System.out.print("* ");
            }System.out.println( );
        }
}
}
